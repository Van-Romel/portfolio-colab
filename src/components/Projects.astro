---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../i18n/utils';
import { t } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i18n = t(locale);

const projects: CollectionEntry<'projects'>[] = await getCollection('projects');
const sortedProjects = projects
  .filter((p: CollectionEntry<'projects'>) => p.data.visible !== false)
  .sort((a: CollectionEntry<'projects'>, b: CollectionEntry<'projects'>) => a.data.order - b.data.order);
---

<section id="projetos" class="relative py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center animate-on-scroll">
      <p class="text-sm font-semibold uppercase tracking-widest text-indigo-500 dark:text-indigo-400">{i18n.projects.label}</p>
      <h2 class="mt-3 text-3xl sm:text-4xl font-bold text-slate-900 dark:text-white">
        {i18n.projects.title} <span class="bg-gradient-to-r from-indigo-500 to-blue-500 bg-clip-text text-transparent">{i18n.projects.titleHighlight}</span>
      </h2>
      <p class="mt-4 text-lg text-slate-600 dark:text-slate-400 max-w-2xl mx-auto">
        {i18n.projects.subtitle}
      </p>
    </div>

    <div class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {sortedProjects.map((project, index) => {
        const id = project.id || '';
        const isAudi = id.includes('audi');
        const isTributaliza = id.includes('tributaliza');
        const isJiuMind = id.includes('jiumind');
        const isVault = id.includes('vault');
        const isNatixis = id.includes('natixis') || id.includes('kyc');
        const isMastercard = id.includes('mastercard');

        return (
          <div class={`animate-on-scroll stagger-${(index % 3) + 1} group relative rounded-2xl border border-slate-200 dark:border-slate-700/80 bg-white/90 dark:bg-slate-800/80 backdrop-blur-md overflow-hidden hover:border-indigo-500/50 transition-all duration-500 hover:-translate-y-1 hover:shadow-2xl hover:shadow-indigo-500/10 shadow-xl flex flex-col justify-between`}>
            
            <!-- Bespoke Brand Visual Hero for each project -->
            {isAudi && (
              <div class="h-44 sm:h-48 bg-gradient-to-br from-slate-950 via-zinc-900 to-neutral-900 relative overflow-hidden flex flex-col justify-between p-4 sm:p-5 border-b border-white/5">
                <div class="absolute inset-0 bg-[radial-gradient(#38bdf8_1px,transparent_1px)] [background-size:16px_16px] opacity-10"></div>
                <div class="absolute -right-8 -top-8 w-32 h-32 bg-blue-500/10 rounded-full blur-2xl pointer-events-none"></div>
                <div class="relative z-10 flex items-center justify-between">
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-bold tracking-wider uppercase bg-white/10 text-slate-200 backdrop-blur-md border border-white/15">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                    Volkswagen Group
                  </span>
                  <span class="text-[10px] font-mono text-slate-400">Azure AKS // 1M+ Events</span>
                </div>
                <div class="relative z-10 flex flex-col items-center justify-center my-auto py-1">
                  <!-- Audi 4 Rings Official SVG -->
                  <svg class="h-9 w-auto text-white/90 drop-shadow-[0_4px_12px_rgba(255,255,255,0.15)] group-hover:scale-105 transition-transform duration-500" viewBox="0 0 100 36" fill="none" stroke="currentColor" stroke-width="2.6">
                    <circle cx="20" cy="18" r="14" />
                    <circle cx="40" cy="18" r="14" />
                    <circle cx="60" cy="18" r="14" />
                    <circle cx="80" cy="18" r="14" />
                  </svg>
                  <span class="mt-2 text-[11px] font-bold tracking-widest text-slate-300 uppercase">Audi Connect Plug & Play</span>
                </div>
                <div class="relative z-10 flex items-center justify-between text-[10px] text-slate-400 pt-1.5 border-t border-white/5">
                  <span>Vehicle Telemetry</span>
                  <span class="text-emerald-400 font-mono font-semibold">Zero OOMKills</span>
                </div>
              </div>
            )}

            {isTributaliza && (
              <div class="h-44 sm:h-48 bg-gradient-to-br from-slate-950 via-indigo-950 to-blue-950 relative overflow-hidden flex flex-col justify-between p-4 sm:p-5 border-b border-white/5">
                <div class="absolute inset-0 bg-[radial-gradient(#6366f1_1px,transparent_1px)] [background-size:16px_16px] opacity-15"></div>
                <div class="absolute -right-8 -top-8 w-32 h-32 bg-indigo-500/15 rounded-full blur-2xl pointer-events-none"></div>
                <div class="relative z-10 flex items-center justify-between">
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-bold tracking-wider uppercase bg-indigo-500/20 text-indigo-200 backdrop-blur-md border border-indigo-400/20">
                    <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
                    Ativos Digital
                  </span>
                  <span class="text-[10px] font-mono text-indigo-300">Millions NFC-e/Day</span>
                </div>
                <div class="relative z-10 flex flex-col items-center justify-center my-auto py-1">
                  <div class="h-11 w-11 rounded-xl bg-gradient-to-tr from-amber-500 to-indigo-600 flex items-center justify-center shadow-lg shadow-indigo-500/30 group-hover:scale-105 transition-transform duration-500">
                    <svg class="h-6 w-6 text-white" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" />
                    </svg>
                  </div>
                  <span class="mt-2 text-[11px] font-bold tracking-widest text-white uppercase">Tributaliza Engine</span>
                </div>
                <div class="relative z-10 flex items-center justify-between text-[10px] text-slate-400 pt-1.5 border-t border-white/5">
                  <span>Spring Data JDBC + Rust</span>
                  <span class="text-indigo-300 font-mono font-semibold">Tauri 2 + Pulsar</span>
                </div>
              </div>
            )}

            {isJiuMind && (
              <div class="h-44 sm:h-48 bg-gradient-to-br from-zinc-950 via-stone-900 to-black relative overflow-hidden flex flex-col justify-between p-4 sm:p-5 border-b border-white/5">
                <div class="absolute inset-0 bg-[radial-gradient(#e11d48_1px,transparent_1px)] [background-size:16px_16px] opacity-10"></div>
                <div class="absolute -right-8 -top-8 w-32 h-32 bg-rose-500/10 rounded-full blur-2xl pointer-events-none"></div>
                <div class="relative z-10 flex items-center justify-between">
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-bold tracking-wider uppercase bg-white/10 text-rose-200 backdrop-blur-md border border-rose-500/20">
                    <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>
                    JiuMind BJJ
                  </span>
                  <span class="text-[10px] font-mono text-rose-300">Edge Latency &lt;50ms</span>
                </div>
                <div class="relative z-10 flex flex-col items-center justify-center my-auto py-1">
                  <div class="h-11 w-11 rounded-xl bg-gradient-to-tr from-zinc-800 via-rose-950 to-zinc-900 border border-rose-500/40 flex items-center justify-center shadow-lg shadow-rose-950/50 group-hover:scale-105 transition-transform duration-500">
                    <span class="text-xl">🥋</span>
                  </div>
                  <span class="mt-2 text-[11px] font-bold tracking-widest text-slate-200 uppercase">JiuMind Platform</span>
                </div>
                <div class="relative z-10 flex items-center justify-between text-[10px] text-slate-400 pt-1.5 border-t border-white/5">
                  <span>Athlete Video Catalog</span>
                  <span class="text-rose-400 font-mono font-semibold">Cloudflare KV + K3s</span>
                </div>
              </div>
            )}

            {isVault && (
              <div class="h-44 sm:h-48 bg-gradient-to-br from-slate-950 via-emerald-950 to-slate-900 relative overflow-hidden flex flex-col justify-between p-4 sm:p-5 border-b border-white/5">
                <div class="absolute inset-0 bg-[radial-gradient(#10b981_1px,transparent_1px)] [background-size:16px_16px] opacity-15"></div>
                <div class="absolute -right-8 -top-8 w-32 h-32 bg-emerald-500/15 rounded-full blur-2xl pointer-events-none"></div>
                <div class="relative z-10 flex items-center justify-between">
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-bold tracking-wider uppercase bg-emerald-500/20 text-emerald-200 backdrop-blur-md border border-emerald-400/20">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                    SC TechLabs Core
                  </span>
                  <span class="text-[10px] font-mono text-emerald-300">AES-256-GCM</span>
                </div>
                <div class="relative z-10 flex flex-col items-center justify-center my-auto py-1">
                  <div class="h-11 w-11 rounded-xl bg-gradient-to-tr from-emerald-600 to-teal-500 flex items-center justify-center shadow-lg shadow-emerald-500/30 group-hover:scale-105 transition-transform duration-500">
                    <svg class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
                    </svg>
                  </div>
                  <span class="mt-2 text-[11px] font-bold tracking-widest text-white uppercase">SCTechLabs Vault</span>
                </div>
                <div class="relative z-10 flex items-center justify-between text-[10px] text-slate-400 pt-1.5 border-t border-white/5">
                  <span>Zero-Knowledge Secrets</span>
                  <span class="text-emerald-400 font-mono font-semibold">Cloudflare Workers</span>
                </div>
              </div>
            )}

            {isNatixis && (
              <div class="h-44 sm:h-48 bg-gradient-to-br from-slate-950 via-purple-950 to-indigo-950 relative overflow-hidden flex flex-col justify-between p-4 sm:p-5 border-b border-white/5">
                <div class="absolute inset-0 bg-[radial-gradient(#a855f7_1px,transparent_1px)] [background-size:16px_16px] opacity-10"></div>
                <div class="absolute -right-8 -top-8 w-32 h-32 bg-purple-500/10 rounded-full blur-2xl pointer-events-none"></div>
                <div class="relative z-10 flex items-center justify-between">
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-bold tracking-wider uppercase bg-purple-500/20 text-purple-200 backdrop-blur-md border border-purple-400/20">
                    <span class="w-1.5 h-1.5 rounded-full bg-purple-400"></span>
                    Natixis CIB
                  </span>
                  <span class="text-[10px] font-mono text-purple-300">BPCE Group // EU</span>
                </div>
                <div class="relative z-10 flex flex-col items-center justify-center my-auto py-1">
                  <div class="h-11 w-11 rounded-xl bg-gradient-to-tr from-purple-600 to-indigo-600 flex items-center justify-center shadow-lg shadow-purple-500/30 group-hover:scale-105 transition-transform duration-500">
                    <svg class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 21v-8.25M15.75 21v-8.25M8.25 21v-8.25M3 9l9-6 9 6m-1.5 12V10.5m-15 10.5V10.5" />
                    </svg>
                  </div>
                  <span class="mt-2 text-[11px] font-bold tracking-widest text-white uppercase">KYC Platform</span>
                </div>
                <div class="relative z-10 flex items-center justify-between text-[10px] text-slate-400 pt-1.5 border-t border-white/5">
                  <span>Banking Compliance</span>
                  <span class="text-purple-300 font-mono font-semibold">Spring Batch 3</span>
                </div>
              </div>
            )}

            {isMastercard && (
              <div class="h-44 sm:h-48 bg-gradient-to-br from-neutral-950 via-stone-900 to-amber-950 relative overflow-hidden flex flex-col justify-between p-4 sm:p-5 border-b border-white/5">
                <div class="absolute inset-0 bg-[radial-gradient(#f97316_1px,transparent_1px)] [background-size:16px_16px] opacity-10"></div>
                <div class="absolute -right-8 -top-8 w-32 h-32 bg-amber-500/10 rounded-full blur-2xl pointer-events-none"></div>
                <div class="relative z-10 flex items-center justify-between">
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-bold tracking-wider uppercase bg-amber-500/20 text-amber-200 backdrop-blur-md border border-amber-400/20">
                    <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
                    Mastercard
                  </span>
                  <span class="text-[10px] font-mono text-amber-300">ID Services Portal</span>
                </div>
                <div class="relative z-10 flex flex-col items-center justify-center my-auto py-1">
                  <!-- Official Mastercard Intersecting Dual Circles SVG -->
                  <svg class="h-9 w-auto group-hover:scale-105 transition-transform duration-500 drop-shadow-[0_4px_12px_rgba(235,0,27,0.3)]" viewBox="0 0 100 60" fill="none">
                    <circle cx="34" cy="30" r="26" fill="#EB001B" />
                    <circle cx="66" cy="30" r="26" fill="#F79E1B" fill-opacity="0.9" />
                    <path d="M50 11.5a25.8 25.8 0 010 37 25.8 25.8 0 010-37z" fill="#FF5F00" />
                  </svg>
                  <span class="mt-2 text-[11px] font-bold tracking-widest text-slate-200 uppercase">Mastercard ID Services</span>
                </div>
                <div class="relative z-10 flex items-center justify-between text-[10px] text-slate-400 pt-1.5 border-t border-white/5">
                  <span>Digital Identity API</span>
                  <span class="text-amber-400 font-mono font-semibold">SAFe Agile + Spring</span>
                </div>
              </div>
            )}

            {!isAudi && !isTributaliza && !isJiuMind && !isVault && !isNatixis && !isMastercard && (
              <div class="h-44 sm:h-48 bg-gradient-to-br from-indigo-600 to-blue-600 relative overflow-hidden flex items-center justify-center">
                <span class="text-white font-bold text-lg">{project.data.title[locale]}</span>
              </div>
            )}

            <div class="p-5 flex-1 flex flex-col justify-between">
              <div>
                <h3 class="text-lg font-bold text-slate-900 dark:text-white group-hover:text-indigo-500 dark:group-hover:text-indigo-400 transition-colors duration-300">
                  {project.data.title[locale]}
                </h3>
                <p class="mt-1 text-xs font-semibold text-indigo-600 dark:text-indigo-400">
                  {project.data.dev}
                </p>
                <p class="mt-2.5 text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
                  {project.data.description[locale]}
                </p>

                <div class="mt-3.5 flex flex-wrap gap-1.5">
                  {project.data.techStack.map((tech: string) => (
                    <span class="inline-flex items-center rounded-md bg-indigo-50 dark:bg-indigo-900/30 px-2 py-0.5 text-[10px] font-medium text-indigo-600 dark:text-indigo-300 ring-1 ring-inset ring-indigo-500/20">
                      {tech}
                    </span>
                  ))}
                </div>
              </div>

              {project.data.demoUrl && project.data.demoUrl !== '#' && (
                <div class="mt-5 flex items-center gap-4 pt-4 border-t border-slate-100 dark:border-slate-800/60">
                  <a href={project.data.demoUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-xs font-semibold text-indigo-600 dark:text-indigo-400 hover:text-indigo-500 dark:hover:text-indigo-300 transition-colors">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                    </svg>
                    {locale === 'pt' ? 'Acessar Projeto' : locale === 'fr' ? 'Visiter le Projet' : 'Visit Website'}
                  </a>
                </div>
              )}
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
