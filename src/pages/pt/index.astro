  <script is:inline define:vars={{ blueprints }}>
    const buttons = document.querySelectorAll('.blueprint-tab-btn');
    const problemEl = document.getElementById('bp-problem');
    const decisionEl = document.getElementById('bp-decision');
    const outcomeEl = document.getElementById('bp-outcome');
    const tagsContainer = document.getElementById('blueprint-tags');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const idx = Number(btn.getAttribute('data-blueprint-index'));
        const bp = blueprints[idx];
        if (!bp) return;

        buttons.forEach((b) => {
          b.classList.remove('border-indigo-500/50', 'bg-indigo-950/20', 'text-indigo-300');
          b.classList.add('border-slate-800', 'bg-slate-900/40', 'text-slate-400');
        });

        btn.classList.remove('border-slate-800', 'bg-slate-900/40', 'text-slate-400');
        btn.classList.add('border-indigo-500/50', 'bg-indigo-950/20', 'text-indigo-300');

        if (problemEl) problemEl.textContent = bp.problem;
        if (decisionEl) decisionEl.textContent = bp.decision;
        if (outcomeEl) outcomeEl.textContent = bp.outcome;

        if (tagsContainer) {
          tagsContainer.innerHTML = bp.tags
            .map(t => `<span class="px-2 py-1 bg-slate-900 border border-slate-700 text-slate-300 rounded">${t}</span>`)
            .join('');
        }
      });
    });
  </script>
