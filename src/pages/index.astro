---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import vanromelPhoto from '../assets/vanromel.jpg';
import rafaelPhoto from '../assets/rafael.png';

const locale = 'en';
const pageTitle = "SC TechLabs // Enterprise Systems Architecture";
const pageDescription = "Boutique systems engineering and software architecture studio. High-throughput distributed backends, edge computing, memory profiling, and enterprise cloud infrastructure in Java 21, Kotlin, and Rust.";

const projects = [
  {
    client: "VOLKSWAGEN GROUP",
    title: "Audi Connect Plug & Play",
    category: "CONNECTED VEHICLES // HIGH-THROUGHPUT BATCH",
    description: "Pan-European connected vehicle telemetry microservices in Kotlin and Java 21 on Azure / Kubernetes (AKS). Diagnosed and eliminated root-cause memory leaks via sliced batch processing with explicit JPA session evictions, draining a backlog of 1M+ vehicle events in 1 week without scaling pods.",
    metrics: [
      { label: "Backlog Drained", value: "1,000,000+" },
      { label: "Pod Scaling", value: "Zero (0)" },
      { label: "CVEs Remediated", value: "1,000+ down to <100" }
    ],
    tech: ["Java 21", "Kotlin", "Spring Boot", "Azure AKS", "PostgreSQL", "OpenDXM GlobalX", "DigiCert mTLS"],
    featured: true,
    demoUrl: "https://www.audi.co.uk/en/owners/audi-connect/plug-and-play/",
    githubUrl: "https://github.com/Van-Romel"
  },
  {
    client: "ATIVOS DIGITAL",
    title: "Tributaliza Fiscal Engine",
    category: "FINANCIAL COMPLIANCE // HIGH CONCURRENCY",
    description: "High-volume taxation calculation engine computing ICMS, PIS, and COFINS for millions of Brazilian NFC-e documents per day. Persistence layer re-architected to Spring Data JDBC and JasperReports disk virtualization (JRSwapFileVirtualizer), permanently eliminating OutOfMemory crashes.",
    metrics: [
      { label: "Throughput", value: "Millions NFC-e/Day" },
      { label: "Report Virtualizer", value: "Disk Swap File" },
      { label: "Memory Overhead", value: "Near-Zero OOM" }
    ],
    tech: ["Java 21", "Spring Data JDBC", "Rust (Tauri 2)", "Apache Pulsar", "PostgreSQL", "Flyway"],
    featured: false,
    demoUrl: "https://tributaliza.com.br",
    githubUrl: "https://github.com/Van-Romel"
  },
  {
    client: "JIUMIND BJJ",
    title: "JiuMind High-Performance Platform",
    category: "GLOBAL ATHLETE CATALOG // LOW LATENCY",
    description: "Global martial arts video training and athlete catalog platform engineered for sub-50ms edge latency using a 3-tier caching topology (Caffeine L1 in-memory, Cloudflare KV L2 at edge, and optimized PostgreSQL).",
    metrics: [
      { label: "Edge Latency", value: "< 50ms Global" },
      { label: "Cache Topology", value: "3-Tier (L1/L2/DB)" },
      { label: "Edge Provider", value: "Cloudflare KV" }
    ],
    tech: ["Cloudflare Edge", "Cloudflare KV", "Java 21", "PostgreSQL", "Caffeine", "Docker"],
    featured: false,
    demoUrl: "https://jiumind.com",
    githubUrl: "https://github.com/Van-Romel"
  },
  {
    client: "SC TECHLABS INTERNAL",
    title: "SCTechLabs Vault & Zero Trust",
    category: "ENTERPRISE SECURITY // ZERO-KNOWLEDGE",
    description: "Internal and client credential management vault featuring client-side zero-knowledge encryption using AES-256-GCM. Encrypted payloads are synchronized via Cloudflare Workers and shielded behind Cloudflare Zero Trust Access.",
    metrics: [
      { label: "Encryption", value: "AES-256-GCM" },
      { label: "Access Model", value: "Zero Knowledge" },
      { label: "Perimeter", value: "Zero Trust Tunnel" }
    ],
    tech: ["AES-256-GCM", "Cloudflare Workers", "Cloudflare Zero Trust", "TypeScript", "WebCrypto"],
    featured: false,
    demoUrl: "https://sctechlabs.com",
    githubUrl: "https://github.com/Van-Romel"
  },
  {
    client: "NATIXIS CIB",
    title: "KYC Regulatory Compliance Engine",
    category: "BANKING REGULATIONS // EUROPEAN COMPLIANCE",
    description: "Enterprise Know Your Customer (KYC) regulatory compliance platform for corporate banking. Developed backend services and batch processing pipelines using Spring Boot 2, Spring Batch 3, and Oracle SQL, deployed across testing and production via Jenkins and XL Deploy.",
    metrics: [
      { label: "Framework", value: "Spring Batch 3" },
      { label: "Database", value: "Oracle SQL" },
      { label: "Deployment", value: "XL Deploy / Release" }
    ],
    tech: ["Java 8", "Spring Boot 2", "Spring Batch 3", "Oracle SQL", "Angular 11", "XL Deploy", "Jenkins"],
    featured: false,
    demoUrl: "https://www.natixis.com",
    githubUrl: "https://github.com/Van-Romel"
  },
  {
    client: "MASTERCARD",
    title: "Mastercard ID Service Reference Apps",
    category: "IDENTITY GOVERNANCE // DEVELOPER BLUEPRINTS",
    description: "Official developer integration blueprints and reference applications for Mastercard Digital Identity Services. Authored low-level design specifications (LLD), managed enterprise release governance for BizOps rollouts, and maintained OpenAPI 3 DSL developer specs.",
    metrics: [
      { label: "Program", value: "Mastercard ID" },
      { label: "Architecture", value: "LLD & Diagram.io" },
      { label: "Standards", value: "OpenAPI 3 DSL" }
    ],
    tech: ["Java", "Spring Framework", "Angular", "Azure", "CosmosDB", "Jenkins CI/CD", "OpenAPI 3"],
    featured: false,
    demoUrl: "https://developer.mastercard.com/product/id-digital-identity-services",
    githubUrl: "https://github.com/Van-Romel"
  }
];

const team = [
  {
    name: "Rafael Carvalho Gomes",
    role: "Co-Founder & Chief Technology Officer",
    location: "Brazil (UTC-3)",
    flag: "🇧🇷",
    photo: rafaelPhoto,
    bio: "Senior Java/Kotlin specialist with extensive experience across cloud-native architectures, distributed batch processing, OutSystems, and high-concurrency systems design.",
    linkedin: "https://www.linkedin.com/in/rafael-carvalho-gomes-700752101/",
    skills: ["Java", "Kotlin", "Spring Boot", "PostgreSQL", "Kubernetes", "AWS", "System Design"]
  },
  {
    name: "Van-Romel Alves Sena Neto",
    role: "Co-Founder & Principal Solutions Architect",
    location: "Portugal / Germany (UTC+0 / UTC+1)",
    flag: "🇵🇹",
    photo: vanromelPhoto,
    bio: "Lead Backend Engineer & Technical Owner for Volkswagen Group (Audi Connect). Advisor on distributed systems, edge architectures, zero-trust security, and memory profiling.",
    linkedin: "https://www.linkedin.com/in/van-romel-neto/",
    skills: ["Java 21", "Kotlin", "Spring Data JDBC", "Kubernetes AKS", "Cloudflare Edge", "Rust (Tauri 2)", "PostgreSQL"]
  },
  {
    name: "Fabrício",
    role: "Software Developer (Full-Stack)",
    location: "Brazil (UTC-3)",
    flag: "🇧🇷",
    photo: null,
    bio: "Backend and full-stack software engineer delivering robust REST APIs, high-throughput database operations, and continuous integration pipelines across Tributaliza and JiuMind.",
    linkedin: "https://www.linkedin.com/in/van-romel-neto/",
    skills: ["Java", "Spring Boot", "PostgreSQL", "Docker", "RESTful Architecture", "Gitflow"]
  }
];

const blueprints = [
  {
    id: "01",
    tabTitle: "01. Sliced Batch Processing",
    client: "Volkswagen Group / Audi Connect",
    badge: "✓ Drained 1M+ event backlog",
    problem: "High-throughput vehicle telemetry in Kubernetes AKS was experiencing sporadic OOMKills under heavy load due to Hibernate 1st-level cache retaining entities across batch chunks.",
    decision: "Replaced standard repository paging with Slice<T> iteration, deterministic chunk size constraints, and explicit entityManager.clear() evictions at boundary commits.",
    outcome: "Drained an accumulated backlog of 1,000,000+ vehicle events within 7 days, maintaining a flat memory footprint and avoiding costly pod horizontal scaling.",
    tags: ["[ KOTLIN / JAVA 21 ]", "[ JPA SESSION EVICTION ]", "[ AZURE AKS ]", "[ 1M+ EVENTS ]"]
  },
  {
    id: "02",
    tabTitle: "02. Disk Swap Virtualizer",
    client: "Tributaliza Fiscal Engine",
    badge: "✓ Zero OutOfMemory crashes",
    problem: "Heavy fiscal report generation and mass NFC-e tax calculations were exhausting JVM heap memory during monthly peak closing windows.",
    decision: "Re-architected persistence layer from heavy ORM to lightweight Spring Data JDBC, and configured JasperReports with JRSwapFileVirtualizer to page temporary report structures directly to disk.",
    outcome: "Permanently eliminated OutOfMemory heap crashes, processing millions of tax documents daily with flat, deterministic RAM utilization.",
    tags: ["[ JAVA 21 ]", "[ SPRING DATA JDBC ]", "[ DISK VIRTUALIZER ]", "[ POSTGRESQL ]"]
  },
  {
    id: "03",
    tabTitle: "03. 3-Tier Edge Topology",
    client: "JiuMind BJJ Platform",
    badge: "✓ < 50ms edge catalog latency",
    problem: "Global martial arts practitioners experienced high lookup and video streaming latency when querying centralized relational databases from overseas.",
    decision: "Architected a 3-tier caching topology combining in-memory local caches (Caffeine L1), distributed edge key-value storage (Cloudflare KV L2), and an optimized origin PostgreSQL cluster.",
    outcome: "Achieved sub-50ms edge response times worldwide, offloading over 90% of read traffic away from central database instances.",
    tags: ["[ CLOUDFLARE EDGE ]", "[ CLOUDFLARE KV ]", "[ CAFFEINE L1 ]", "[ POSTGRESQL ]"]
  }
];
---

<Layout locale={locale} title={pageTitle} description={pageDescription}>
  <!-- MAIN HUD HEADER -->
  <header class="border-b border-slate-800/80 bg-[#080C14]/90 backdrop-blur-md sticky top-0 z-40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <a href="/" class="flex items-center gap-3 group">
        <div class="h-8 w-8 rounded bg-slate-900 border border-slate-700 flex items-center justify-center font-mono text-xs font-bold text-indigo-400 group-hover:border-indigo-500 transition-colors">
          SC
        </div>
        <div>
          <span class="font-bold text-slate-100 tracking-tight text-sm sm:text-base">SC TECHLABS</span>
          <span class="hidden sm:inline font-mono text-[10px] text-slate-500 ml-2">SYSTEMS_ARCHITECTURE // v2.0</span>
        </div>
      </a>

      <nav class="hidden md:flex items-center gap-6 font-mono text-xs text-slate-400">
        <a href="#cases" class="hover:text-indigo-400 transition-colors">01. Cases</a>
        <a href="#disciplines" class="hover:text-indigo-400 transition-colors">02. Disciplines</a>
        <a href="#architecture" class="hover:text-indigo-400 transition-colors">03. Blueprints</a>
        <a href="#team" class="hover:text-indigo-400 transition-colors">04. Engineering Team</a>
        <a href="#contact" class="hover:text-indigo-400 transition-colors">05. Direct Intake</a>
      </nav>

      <div class="flex items-center gap-3">
        <!-- Language Switcher -->
        <div class="flex items-center gap-1 font-mono text-xs">
          <span class="text-indigo-400 font-bold px-2 py-0.5 rounded bg-indigo-950/60 border border-indigo-800/60">EN</span>
          <a href="/pt/" class="text-slate-400 hover:text-white px-2 py-0.5 rounded border border-slate-800 hover:border-slate-700 transition-colors">PT</a>
        </div>

        <span class="hidden lg:inline-flex items-center gap-1.5 font-mono text-[11px] text-emerald-400 bg-emerald-950/40 border border-emerald-800/50 px-2.5 py-1 rounded">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          PROD_READY
        </span>
        <a href="#contact" class="font-mono text-xs px-3.5 py-1.5 bg-indigo-600 hover:bg-indigo-500 text-white rounded font-medium transition-colors border border-indigo-500/50">
          Book Technical Review
        </a>
      </div>
    </div>
  </header>

  <main class="bg-[#080C14] text-slate-200 min-h-screen">

    <!-- HERO SECTION (EDITORIAL & ARCHITECTURAL) -->
    <section class="relative pt-16 pb-20 border-b border-slate-800/80">
      <!-- Architectural structural grid (subtle 1px hairline) -->
      <div class="absolute inset-0 pointer-events-none opacity-[0.04]" style="background-image: linear-gradient(#94A3B8 1px, transparent 1px), linear-gradient(90deg, #94A3B8 1px, transparent 1px); background-size: 48px 48px;"></div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
        <div class="max-w-4xl">
          <!-- Monospace Kicker -->
          <div class="inline-flex items-center gap-2 font-mono text-xs text-indigo-400 bg-indigo-950/40 border border-indigo-800/50 px-3 py-1 rounded mb-6">
            <span>[ SYSTEM SPECIFICATION ]</span>
            <span class="text-slate-500">//</span>
            <span>HIGH-THROUGHPUT BACKENDS & DISTRIBUTED SYSTEMS</span>
          </div>

          <!-- Stark, High-Contrast Typography (NO RAINBOW GRADIENTS) -->
          <h1 class="text-4xl sm:text-6xl font-extrabold text-slate-50 tracking-tight leading-[1.08]">
            Architecting High-Throughput Cloud & Edge Systems.
          </h1>

          <p class="mt-6 text-lg sm:text-xl text-slate-400 leading-relaxed max-w-3xl">
            Boutique software engineering consultancy founded by staff-level engineers. We design, optimize, and rescue mission-critical backends in Kotlin, Java 21, and Rust — replacing AI hallucinations and cookie-cutter templates with verified production code.
          </p>

          <!-- Action Buttons -->
          <div class="mt-8 flex flex-wrap items-center gap-4">
            <a href="#contact" class="font-mono text-sm px-6 py-3 bg-slate-50 hover:bg-slate-200 text-slate-950 rounded font-semibold transition-all">
              Schedule Architecture Review &rarr;
            </a>
            <a href="#cases" class="font-mono text-sm px-6 py-3 bg-slate-900/80 hover:bg-slate-800 text-slate-300 rounded font-medium border border-slate-700 transition-all">
              Inspect Technical Cases ↓
            </a>
          </div>
        </div>

        <!-- HUD METRICS BAR (HAIRLINE BORDER GRID) -->
        <div class="mt-16 grid grid-cols-2 md:grid-cols-4 border border-slate-800 bg-slate-950/60 divide-y md:divide-y-0 md:divide-x divide-slate-800 rounded-lg overflow-hidden">
          <div class="p-6">
            <div class="font-mono text-xs text-indigo-400 uppercase tracking-wider">[ THROUGHPUT ]</div>
            <div class="mt-2 text-3xl font-extrabold text-slate-100 font-mono">1M+</div>
            <div class="mt-1 text-xs text-slate-400">Events & NFC-e Processed Daily</div>
          </div>
          <div class="p-6">
            <div class="font-mono text-xs text-cyan-400 uppercase tracking-wider">[ EDGE LATENCY ]</div>
            <div class="mt-2 text-3xl font-extrabold text-slate-100 font-mono">&lt; 50ms</div>
            <div class="mt-1 text-xs text-slate-400">3-Tier Edge & KV Topology</div>
          </div>
          <div class="p-6">
            <div class="font-mono text-xs text-emerald-400 uppercase tracking-wider">[ TRACK RECORD ]</div>
            <div class="mt-2 text-3xl font-extrabold text-slate-100 font-mono">+10 Yrs</div>
            <div class="mt-1 text-xs text-slate-400">Enterprise Java / Cloud Systems</div>
          </div>
          <div class="p-6">
            <div class="font-mono text-xs text-amber-400 uppercase tracking-wider">[ INTEGRITY ]</div>
            <div class="mt-2 text-3xl font-extrabold text-slate-100 font-mono">100%</div>
            <div class="mt-1 text-xs text-slate-400">Truthful, Production-Verified Metrics</div>
          </div>
        </div>
      </div>
    </section>

    <!-- ARCHITECTURE BLUEPRINT INSPECTOR (LIVE TECH SHOWCASE) -->
    <section id="architecture" class="py-20 border-b border-slate-800/80 bg-[#0A0F1A]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-10">
          <div>
            <div class="font-mono text-xs text-indigo-400">[ ARCHITECTURAL PATTERNS ]</div>
            <h2 class="mt-2 text-2xl sm:text-3xl font-bold text-slate-100 tracking-tight">
              Production Solutions, Not Mock Demos.
            </h2>
          </div>
          <p class="text-sm text-slate-400 max-w-md">
            Click through real architectural implementations we engineered to solve memory leaks, scaling bottlenecks, and edge latency.
          </p>
        </div>

        <div class="border border-slate-800 bg-[#080C14] rounded-lg overflow-hidden">
          <!-- Terminal tab header -->
          <div class="bg-slate-950 px-4 py-3 border-b border-slate-800 flex items-center justify-between font-mono text-xs">
            <div class="flex items-center gap-2">
              <span class="h-2 w-2 rounded-full bg-slate-600"></span>
              <span class="text-slate-400">spec_inspector.sh // real_production_cases</span>
            </div>
            <div class="text-slate-500 hidden sm:block">STATUS: VERIFIED_IN_PROD</div>
          </div>

          <!-- Interactive Blueprint Tabs -->
          <div class="p-6 md:p-8 grid md:grid-cols-3 gap-8">
            <div class="space-y-3" id="blueprint-tabs">
              {blueprints.map((bp, idx) => (
                <button
                  type="button"
                  data-blueprint-index={idx}
                  class={`blueprint-tab-btn w-full text-left p-3.5 rounded border font-mono text-xs transition-all cursor-pointer ${idx === 0 ? 'border-indigo-500/50 bg-indigo-950/20 text-indigo-300' : 'border-slate-800 bg-slate-900/40 hover:bg-slate-900 text-slate-400'}`}
                >
                  <div class="font-bold text-slate-100 text-sm">{bp.tabTitle}</div>
                  <div class="text-[11px] text-slate-400 mt-1">{bp.client}</div>
                  <div class="text-[10px] text-emerald-400 mt-1.5">{bp.badge}</div>
                </button>
              ))}
            </div>

            <div class="md:col-span-2 font-mono text-xs bg-slate-950 p-5 rounded border border-slate-800 space-y-4">
              <div class="text-slate-400 flex items-center justify-between border-b border-slate-800 pb-3">
                <span class="text-indigo-400 font-bold" id="blueprint-heading">// ARCHITECTURAL DIAGNOSIS &amp; REMEDIATION:</span>
                <span class="text-emerald-400">PASS (EXIT 0)</span>
              </div>

              <div class="space-y-2 text-slate-300 leading-relaxed" id="blueprint-content">
                <p><span class="text-slate-500">PROBLEM:</span> <span id="bp-problem">{blueprints[0].problem}</span></p>
                <p><span class="text-slate-500">DECISION:</span> <span id="bp-decision">{blueprints[0].decision}</span></p>
                <p><span class="text-slate-500">OUTCOME:</span> <span id="bp-outcome">{blueprints[0].outcome}</span></p>
              </div>

              <div class="pt-3 border-t border-slate-800 flex flex-wrap gap-2 text-[10px]" id="blueprint-tags">
                {blueprints[0].tags.map(t => (
                  <span class="px-2 py-1 bg-slate-900 border border-slate-700 text-slate-300 rounded">{t}</span>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ENTERPRISE CASE STUDIES (BENTO GRID - HIGH CRAFT) -->
    <section id="cases" class="py-20 border-b border-slate-800/80">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-2xl mb-12">
          <div class="font-mono text-xs text-indigo-400">[ PROVEN ENTERPRISE DELIVERABLES ]</div>
          <h2 class="mt-2 text-3xl font-extrabold text-slate-50 tracking-tight">
            Selected Client & Product Architectures.
          </h2>
          <p class="mt-3 text-slate-400">
            Real enterprise case studies with zero marketing fluff. Every metric is backed by production code and auditable track records.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {projects.map((proj) => (
            <article class={`border border-slate-800 bg-[#0C121E] hover:border-indigo-500/50 transition-all rounded-lg p-6 flex flex-col justify-between ${proj.featured ? 'md:col-span-2 lg:col-span-2 bg-[#0E1526]' : ''}`}>
              <div>
                <div class="flex items-center justify-between font-mono text-[11px] text-slate-400 border-b border-slate-800 pb-3">
                  <span class="text-indigo-400 font-bold">{proj.client}</span>
                  <span>{proj.category}</span>
                </div>

                <h3 class="mt-4 text-xl font-bold text-slate-100 tracking-tight">
                  {proj.title}
                </h3>

                <p class="mt-3 text-sm text-slate-300 leading-relaxed">
                  {proj.description}
                </p>

                <!-- Key Metrics -->
                <div class="mt-5 grid grid-cols-3 gap-2 py-3 px-3 bg-slate-950/70 border border-slate-800 rounded font-mono text-xs">
                  {proj.metrics.map(m => (
                    <div>
                      <div class="text-[10px] text-slate-500 uppercase">{m.label}</div>
                      <div class="text-slate-200 font-bold mt-0.5">{m.value}</div>
                    </div>
                  ))}
                </div>
              </div>

              <div class="mt-6 pt-4 border-t border-slate-800">
                <div class="flex flex-wrap gap-1.5 mb-4">
                  {proj.tech.map(t => (
                    <span class="font-mono text-[10px] px-2 py-0.5 rounded bg-slate-900 border border-slate-800 text-slate-300">
                      {t}
                    </span>
                  ))}
                </div>

                <div class="flex items-center justify-between text-xs font-mono">
                  <a href={proj.demoUrl} target="_blank" rel="noopener noreferrer" class="text-indigo-400 hover:text-white transition-colors flex items-center gap-1">
                    <span>Inspect System</span> &rarr;
                  </a>
                  <a href={proj.githubUrl} target="_blank" rel="noopener noreferrer" class="text-slate-500 hover:text-slate-300 transition-colors">
                    GitHub Spec
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- CORE DISCIPLINES (SPECIFIC & AUTHORITY-DRIVEN) -->
    <section id="disciplines" class="py-20 border-b border-slate-800/80 bg-[#0A0F1A]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-2xl mb-12">
          <div class="font-mono text-xs text-indigo-400">[ CAPABILITY MATRIX ]</div>
          <h2 class="mt-2 text-3xl font-extrabold text-slate-50 tracking-tight">
            Architectural Disciplines & Scope.
          </h2>
        </div>

        <div class="grid md:grid-cols-2 gap-6">
          <div class="p-6 border border-slate-800 bg-[#080C14] rounded-lg">
            <div class="font-mono text-xs text-indigo-400">01 // DISTRIBUTED EVENT PROCESSING & MEMORY PROFILING</div>
            <h3 class="mt-2 text-lg font-bold text-slate-100">Batch Optimization & Memory Leak Remediation</h3>
            <p class="mt-2 text-sm text-slate-400 leading-relaxed">
              We diagnose memory bloat, high GC pause times, and thread exhaustion in production Java/Kotlin clusters. Implementing sliced iteration, session flushes, and streaming queues to drain millions of events with constant memory overhead.
            </p>
            <div class="mt-4 font-mono text-xs text-slate-500">
              Stack: Java 21, Kotlin, Spring Batch, Virtual Threads, HikariCP, PostgreSQL.
            </div>
          </div>

          <div class="p-6 border border-slate-800 bg-[#080C14] rounded-lg">
            <div class="font-mono text-xs text-cyan-400">02 // LOW-LATENCY EDGE TOPOLOGIES & CACHING</div>
            <h3 class="mt-2 text-lg font-bold text-slate-100">Edge Caching & Global Content Acceleration</h3>
            <p class="mt-2 text-sm text-slate-400 leading-relaxed">
              Sub-50ms worldwide content delivery through tiered caching: in-memory local caches (Caffeine) paired with Cloudflare Workers / KV on the edge and connection pooling back to central relational engines.
            </p>
            <div class="mt-4 font-mono text-xs text-slate-500">
              Stack: Cloudflare Workers, Cloudflare KV, Caffeine, WebSocket, Redis.
            </div>
          </div>

          <div class="p-6 border border-slate-800 bg-[#080C14] rounded-lg">
            <div class="font-mono text-xs text-emerald-400">03 // REGULATORY COMPLIANCE & ZERO-TRUST SECURITY</div>
            <h3 class="mt-2 text-lg font-bold text-slate-100">GDPR Orchestration & Client-Side Encryption</h3>
