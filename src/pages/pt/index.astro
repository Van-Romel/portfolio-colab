---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import vanromelPhoto from '../../assets/vanromel.jpg';
import rafaelPhoto from '../../assets/rafael.png';

const locale = 'pt';
const pageTitle = "SC TechLabs // Arquitetura de Sistemas Enterprise";
const pageDescription = "Consultoria boutique de engenharia de software e arquitetura de sistemas. Backends distribuídos de alta vazão, computação de borda, profiling de memória e infraestrutura cloud corporativa em Java 21, Kotlin e Rust.";

const projects = [
  {
    client: "VOLKSWAGEN GROUP",
    title: "Audi Connect Plug & Play",
    category: "VEÍCULOS CONECTADOS // PROCESSAMENTO EM LOTE DE ALTA VAZÃO",
    description: "Microsserviços pan-europeus de telemetria para veículos conectados em Kotlin e Java 21 sobre Azure / Kubernetes (AKS). Diagnóstico e resolução de vazamentos de memória raiz através de processamento fatiado com descarte explícito de sessão JPA, drenando 1M+ de eventos em 1 semana sem escalar pods.",
    metrics: [
      { label: "Backlog Drenado", value: "1.000.000+" },
      { label: "Escala de Pods", value: "Zero (0)" },
      { label: "CVEs Remediadas", value: "1.000+ para <100" }
    ],
    tech: ["Java 21", "Kotlin", "Spring Boot", "Azure AKS", "PostgreSQL", "OpenDXM GlobalX", "DigiCert mTLS"],
    featured: true,
    demoUrl: "https://www.audi.co.uk/en/owners/audi-connect/plug-and-play/",
    githubUrl: "https://github.com/Van-Romel"
  },
  {
    client: "ATIVOS DIGITAL",
    title: "Motor Fiscal Tributaliza",
    category: "COMPLIANCE FISCAL // ALTA CONCORRÊNCIA",
    description: "Motor de cálculo tributário de alta volumetria processando ICMS, PIS e COFINS para milhões de notas fiscais (NFC-e) diariamente. Camada de dados re-arquitetada para Spring Data JDBC e relatórios virtualizados em disco (JRSwapFileVirtualizer), eliminando definitivamente erros de OutOfMemory.",
    metrics: [
      { label: "Vazão Diária", value: "Milhões NFC-e/Dia" },
      { label: "Virtualizador", value: "Arquivo Swap em Disco" },
      { label: "Sobrecarga Memória", value: "Zero OOM" }
    ],
    tech: ["Java 21", "Spring Data JDBC", "Rust (Tauri 2)", "Apache Pulsar", "PostgreSQL", "Flyway"],
    featured: false,
    demoUrl: "https://tributaliza.com.br",
    githubUrl: "https://github.com/Van-Romel"
  },
  {
    client: "JIUMIND BJJ",
    title: "Plataforma JiuMind de Alta Performance",
    category: "CATÁLOGO GLOBAL // BAIXA LATÊNCIA",
    description: "Plataforma global de treinamento marcial e catálogo de atletas projetada para latência sub-50ms na borda utilizando topologia de cache em 3 camadas (Caffeine L1 em memória, Cloudflare KV L2 no edge e PostgreSQL otimizado).",
    metrics: [
      { label: "Latência Global", value: "< 50ms Edge" },
      { label: "Topologia Cache", value: "3 Níveis (L1/L2/DB)" },
      { label: "Provedor Edge", value: "Cloudflare KV" }
    ],
    tech: ["Cloudflare Edge", "Cloudflare KV", "Java 21", "PostgreSQL", "Caffeine", "Docker"],
    featured: false,
    demoUrl: "https://jiumind.com",
    githubUrl: "https://github.com/Van-Romel"
  },
  {
    client: "SC TECHLABS INTERNAL",
    title: "SCTechLabs Vault & Zero Trust",
    category: "SEGURANÇA CORPORATIVA // ZERO-KNOWLEDGE",
    description: "Cofre interno de gestão de credenciais e segredos com criptografia client-side de conhecimento zero utilizando AES-256-GCM. Payloads sincronizados via Cloudflare Workers e protegidos por túneis Cloudflare Zero Trust.",
    metrics: [
      { label: "Criptografia", value: "AES-256-GCM" },
      { label: "Modelo de Acesso", value: "Zero Knowledge" },
      { label: "Perímetro", value: "Túnel Zero Trust" }
    ],
    tech: ["AES-256-GCM", "Cloudflare Workers", "Cloudflare Zero Trust", "TypeScript", "WebCrypto"],
    featured: false,
    demoUrl: "https://sctechlabs.com",
    githubUrl: "https://github.com/Van-Romel"
  },
  {
    client: "NATIXIS CIB",
    title: "Motor de Compliance Regulatório KYC",
    category: "REGULAÇÃO BANCÁRIA // COMPLIANCE EUROPEU",
    description: "Plataforma corporativa de compliance regulatório Know Your Customer (KYC) para banco de atacado. Desenvolvimento de microsserviços backend e esteiras em lote com Spring Boot 2, Spring Batch 3 e Oracle SQL, entregues em produção via XL Deploy e Jenkins.",
    metrics: [
      { label: "Framework", value: "Spring Batch 3" },
      { label: "Banco de Dados", value: "Oracle SQL" },
      { label: "Implantação", value: "XL Deploy / Jenkins" }
    ],
    tech: ["Java 8", "Spring Boot 2", "Spring Batch 3", "Oracle SQL", "Angular 11", "XL Deploy", "Jenkins"],
    featured: false,
    demoUrl: "https://www.natixis.com",
    githubUrl: "https://github.com/Van-Romel"
  },
  {
    client: "MASTERCARD",
    title: "Mastercard ID Service Reference Apps",
    category: "GOVERNANÇA DE IDENTIDADE // BLUEPRINTS DE INTEGRAÇÃO",
    description: "Aplicações de referência e especificações técnicas de integração para o serviço global de Identidade Digital da Mastercard. Autoria de LLD (Low-Level Design), governança de release para BizOps e padronização OpenAPI 3 DSL.",
    metrics: [
      { label: "Programa", value: "Mastercard ID" },
      { label: "Engenharia", value: "LLD & Diagram.io" },
      { label: "Padrões", value: "OpenAPI 3 DSL" }
    ],
    tech: ["Java", "Spring Framework", "Angular", "Azure", "CosmosDB", "Jenkins CI/CD", "OpenAPI 3"],
    featured: false,
    demoUrl: "https://developer.mastercard.com/product/id-digital-identity-services",
    githubUrl: "https://github.com/Van-Romel"
  }
];

const team = [
  {
    name: "Rafael Carvalho Gomes",
    role: "Co-Fundador & Chief Technology Officer",
    location: "Brasil (UTC-3)",
    flag: "🇧🇷",
    photo: rafaelPhoto,
    bio: "Especialista sênior em Java/Kotlin com vasta experiência em arquiteturas nativas em nuvem, processamento distribuído em lote, OutSystems e design de sistemas de alta concorrência.",
    linkedin: "https://www.linkedin.com/in/rafael-carvalho-gomes-700752101/",
    skills: ["Java", "Kotlin", "Spring Boot", "PostgreSQL", "Kubernetes", "AWS", "System Design"]
  },
  {
    name: "Van-Romel Alves Sena Neto",
    role: "Co-Fundador & Arquiteto Principal de Soluções",
    location: "Portugal / Alemanha (UTC+0 / UTC+1)",
    flag: "🇵🇹",
    photo: vanromelPhoto,
    bio: "Lead Backend Engineer & Technical Owner na Volkswagen Group (Audi Connect). Consultor em sistemas distribuídos, arquiteturas edge, segurança zero-trust e profiling de memória.",
    linkedin: "https://www.linkedin.com/in/van-romel-neto/",
    skills: ["Java 21", "Kotlin", "Spring Data JDBC", "Kubernetes AKS", "Cloudflare Edge", "Rust (Tauri 2)", "PostgreSQL"]
  },
  {
    name: "Fabrício",
    role: "Desenvolvedor de Software (Full-Stack)",
    location: "Brasil (UTC-3)",
    flag: "🇧🇷",
    photo: null,
    bio: "Engenheiro de software backend e full-stack desenvolvendo APIs REST robustas, operações de banco de dados de alta vazão e pipelines de integração contínua no Tributaliza e JiuMind.",
    linkedin: "https://www.linkedin.com/in/van-romel-neto/",
    skills: ["Java", "Spring Boot", "PostgreSQL", "Docker", "Arquitetura REST", "Gitflow"]
  }
];

const blueprints = [
  {
    id: "01",
    tabTitle: "01. Processamento em Lote com Slices",
    client: "Volkswagen Group / Audi Connect",
    badge: "✓ Drenagem de 1M+ de eventos acumulados",
    problem: "Telemetria veicular de alta vazão no Kubernetes AKS apresentava OOMKills esporádicos sob alta carga devido à retenção de entidades pelo cache de primeiro nível do Hibernate entre os chunks de processamento em lote.",
    decision: "Substituição da paginação padrão por iteração via Slice<T>, controle determinístico do tamanho dos chunks e limpeza explícita de sessão via entityManager.clear() nos commits de fronteira transacional.",
    outcome: "Drenagem completa de um backlog acumulado de mais de 1.000.000 de eventos veiculares em 7 dias, mantendo pegada de memória constante e evitando o escalonamento horizontal desnecessário de pods.",
    tags: ["[ KOTLIN / JAVA 21 ]", "[ JPA SESSION EVICTION ]", "[ AZURE AKS ]", "[ 1M+ EVENTOS ]"]
  },
  {
    id: "02",
    tabTitle: "02. Virtualização em Disco (Swap File)",
    client: "Motor Fiscal Tributaliza",
    badge: "✓ Zero quedas por OutOfMemory",
    problem: "Geração de relatórios fiscais volumosos e processamento massivo de NFC-e causava esgotamento de heap JVM durante picos de encerramento fiscal mensal.",
    decision: "Migração da camada de persistência para Spring Data JDBC (eliminando overhead de ORM) e configuração do JasperReports com JRSwapFileVirtualizer para paginação temporária diretamente em disco.",
    outcome: "Eliminação permanente de travamentos por OOM, permitindo a emissão e processamento contínuo de milhões de documentos fiscais com consumo previsível de RAM.",
    tags: ["[ JAVA 21 ]", "[ SPRING DATA JDBC ]", "[ SWAP VIRTUALIZER ]", "[ POSTGRESQL ]"]
  },
  {
    id: "03",
    tabTitle: "03. Topologia Edge em 3 Camadas",
    client: "Plataforma JiuMind BJJ",
    badge: "✓ Latência < 50ms no catálogo global",
    problem: "Atletas e usuários em escala global enfrentavam latências elevadas de busca e streaming ao consultar bancos de dados relacionais centralizados no exterior.",
    decision: "Arquitetura de cache hierárquico em 3 níveis combinando memória local (Caffeine L1), nós de borda com Cloudflare KV (L2) e banco de dados relacional PostgreSQL otimizado na origem.",
    outcome: "Tempo de resposta do catálogo inferior a 50ms para usuários globais, desacoplando mais de 90% do tráfego de leitura do banco de dados central.",
    tags: ["[ CLOUDFLARE EDGE ]", "[ CLOUDFLARE KV ]", "[ CAFFEINE L1 ]", "[ POSTGRESQL ]"]
  }
];
---

<Layout locale={locale} title={pageTitle} description={pageDescription}>
  <!-- MAIN HUD HEADER -->
  <header class="border-b border-slate-800/80 bg-[#080C14]/90 backdrop-blur-md sticky top-0 z-40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <a href="/pt/" class="flex items-center gap-3 group">
        <div class="h-8 w-8 rounded bg-slate-900 border border-slate-700 flex items-center justify-center font-mono text-xs font-bold text-indigo-400 group-hover:border-indigo-500 transition-colors">
          SC
        </div>
        <div>
          <span class="font-bold text-slate-100 tracking-tight text-sm sm:text-base">SC TECHLABS</span>
          <span class="hidden sm:inline font-mono text-[10px] text-slate-500 ml-2">SISTEMAS_ARQUITETURA // v2.0</span>
        </div>
      </a>

      <nav class="hidden md:flex items-center gap-6 font-mono text-xs text-slate-400">
        <a href="#cases" class="hover:text-indigo-400 transition-colors">01. Cases</a>
        <a href="#disciplines" class="hover:text-indigo-400 transition-colors">02. Disciplinas</a>
        <a href="#architecture" class="hover:text-indigo-400 transition-colors">03. Blueprints</a>
        <a href="#team" class="hover:text-indigo-400 transition-colors">04. Equipe Técnica</a>
        <a href="#contact" class="hover:text-indigo-400 transition-colors">05. Contato Direto</a>
      </nav>

      <div class="flex items-center gap-3">
        <!-- Language Switcher -->
        <div class="flex items-center gap-1 font-mono text-xs">
          <a href="/" class="text-slate-400 hover:text-white px-2 py-0.5 rounded border border-slate-800 hover:border-slate-700 transition-colors">EN</a>
          <span class="text-indigo-400 font-bold px-2 py-0.5 rounded bg-indigo-950/60 border border-indigo-800/60">PT</span>
        </div>

        <span class="hidden lg:inline-flex items-center gap-1.5 font-mono text-[11px] text-emerald-400 bg-emerald-950/40 border border-emerald-800/50 px-2.5 py-1 rounded">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          PROD_READY
        </span>
        <a href="#contact" class="font-mono text-xs px-3.5 py-1.5 bg-indigo-600 hover:bg-indigo-500 text-white rounded font-medium transition-colors border border-indigo-500/50">
          Agendar Revisão Técnica
        </a>
      </div>
    </div>
  </header>

  <main class="bg-[#080C14] text-slate-200 min-h-screen">

    <!-- HERO SECTION (EDITORIAL & ARCHITECTURAL) -->
    <section class="relative pt-16 pb-20 border-b border-slate-800/80">
      <div class="absolute inset-0 pointer-events-none opacity-[0.04]" style="background-image: linear-gradient(#94A3B8 1px, transparent 1px), linear-gradient(90deg, #94A3B8 1px, transparent 1px); background-size: 48px 48px;"></div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
        <div class="max-w-4xl">
          <div class="inline-flex items-center gap-2 font-mono text-xs text-indigo-400 bg-indigo-950/40 border border-indigo-800/50 px-3 py-1 rounded mb-6">
            <span>[ ESPECIFICAÇÃO DE SISTEMAS ]</span>
            <span class="text-slate-500">//</span>
            <span>BACKENDS DE ALTA VAZÃO &amp; SISTEMAS DISTRIBUÍDOS</span>
          </div>

          <h1 class="text-4xl sm:text-6xl font-extrabold text-slate-50 tracking-tight leading-[1.08]">
            Projetando Sistemas Distribuídos e Edge de Alta Vazão.
          </h1>

          <p class="mt-6 text-lg sm:text-xl text-slate-400 leading-relaxed max-w-3xl">
            Consultoria boutique de engenharia de software fundada por engenheiros de nível Staff. Projetamos, otimizamos e recuperamos backends de missão crítica em Kotlin, Java 21 e Rust — substituindo alucinações de IA e templates genéricos por código verificado em produção.
          </p>

          <div class="mt-8 flex flex-wrap items-center gap-4">
            <a href="#contact" class="font-mono text-sm px-6 py-3 bg-slate-50 hover:bg-slate-200 text-slate-950 rounded font-semibold transition-all">
              Agendar Revisão de Arquitetura &rarr;
            </a>
            <a href="#cases" class="font-mono text-sm px-6 py-3 bg-slate-900/80 hover:bg-slate-800 text-slate-300 rounded font-medium border border-slate-700 transition-all">
              Inspecionar Cases Técnicos ↓
            </a>
          </div>
        </div>

        <div class="mt-16 grid grid-cols-2 md:grid-cols-4 border border-slate-800 bg-slate-950/60 divide-y md:divide-y-0 md:divide-x divide-slate-800 rounded-lg overflow-hidden">
          <div class="p-6">
            <div class="font-mono text-xs text-indigo-400 uppercase tracking-wider">[ PROCESSAMENTO ]</div>
            <div class="mt-2 text-3xl font-extrabold text-slate-100 font-mono">1M+</div>
            <div class="mt-1 text-xs text-slate-400">Eventos &amp; NFC-e Processados Diariamente</div>
          </div>
          <div class="p-6">
            <div class="font-mono text-xs text-cyan-400 uppercase tracking-wider">[ LATÊNCIA EDGE ]</div>
            <div class="mt-2 text-3xl font-extrabold text-slate-100 font-mono">&lt; 50ms</div>
            <div class="mt-1 text-xs text-slate-400">Topologia 3-Tier Edge &amp; KV</div>
          </div>
          <div class="p-6">
            <div class="font-mono text-xs text-emerald-400 uppercase tracking-wider">[ EXPERIÊNCIA ]</div>
            <div class="mt-2 text-3xl font-extrabold text-slate-100 font-mono">+10 Anos</div>
            <div class="mt-1 text-xs text-slate-400">Sistemas Corporativos Java &amp; Cloud</div>
          </div>
          <div class="p-6">
            <div class="font-mono text-xs text-amber-400 uppercase tracking-wider">[ INTEGRIDADE ]</div>
            <div class="mt-2 text-3xl font-extrabold text-slate-100 font-mono">100%</div>
            <div class="mt-1 text-xs text-slate-400">Métricas Reais Verificadas em Produção</div>
          </div>
        </div>
      </div>
    </section>

    <!-- ARCHITECTURE BLUEPRINT INSPECTOR -->
    <section id="architecture" class="py-20 border-b border-slate-800/80 bg-[#0A0F1A]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-10">
          <div>
            <div class="font-mono text-xs text-indigo-400">[ PADRÕES ARQUITETURAIS ]</div>
            <h2 class="mt-2 text-2xl sm:text-3xl font-bold text-slate-100 tracking-tight">
              Soluções em Produção, Não Demos Artificiais.
            </h2>
          </div>
          <p class="text-sm text-slate-400 max-w-md">
            Navegue pelas implementações arquiteturais reais que projetamos para sanar vazamentos de memória, gargalos de escala e latência de borda.
          </p>
        </div>

        <div class="border border-slate-800 bg-[#080C14] rounded-lg overflow-hidden">
          <div class="bg-slate-950 px-4 py-3 border-b border-slate-800 flex items-center justify-between font-mono text-xs">
            <div class="flex items-center gap-2">
              <span class="h-2 w-2 rounded-full bg-slate-600"></span>
              <span class="text-slate-400">spec_inspector.sh // cases_reais_em_producao</span>
            </div>
            <div class="text-slate-500 hidden sm:block">STATUS: VERIFICADO_EM_PROD</div>
          </div>

          <div class="p-6 md:p-8 grid md:grid-cols-3 gap-8">
            <div class="space-y-3" id="blueprint-tabs">
              {blueprints.map((bp, idx) => (
                <button
                  type="button"
                  data-blueprint-index={idx}
                  class={`blueprint-tab-btn w-full text-left p-3.5 rounded border font-mono text-xs transition-all cursor-pointer ${idx === 0 ? 'border-indigo-500/50 bg-indigo-950/20 text-indigo-300' : 'border-slate-800 bg-slate-900/40 hover:bg-slate-900 text-slate-400'}`}
                >
                  <div class="font-bold text-slate-100 text-sm">{bp.tabTitle}</div>
                  <div class="text-[11px] text-slate-400 mt-1">{bp.client}</div>
                  <div class="text-[10px] text-emerald-400 mt-1.5">{bp.badge}</div>
                </button>
              ))}
            </div>

            <div class="md:col-span-2 font-mono text-xs bg-slate-950 p-5 rounded border border-slate-800 space-y-4">
              <div class="text-slate-400 flex items-center justify-between border-b border-slate-800 pb-3">
                <span class="text-indigo-400 font-bold" id="blueprint-heading">// DIAGNÓSTICO &amp; REMEDIAÇÃO ARQUITETURAL:</span>
                <span class="text-emerald-400">PASS (EXIT 0)</span>
              </div>

              <div class="space-y-2 text-slate-300 leading-relaxed" id="blueprint-content">
                <p><span class="text-slate-500">PROBLEMA:</span> <span id="bp-problem">{blueprints[0].problem}</span></p>
                <p><span class="text-slate-500">DECISÃO:</span> <span id="bp-decision">{blueprints[0].decision}</span></p>
                <p><span class="text-slate-500">RESULTADO:</span> <span id="bp-outcome">{blueprints[0].outcome}</span></p>
              </div>

              <div class="pt-3 border-t border-slate-800 flex flex-wrap gap-2 text-[10px]" id="blueprint-tags">
                {blueprints[0].tags.map(t => (
                  <span class="px-2 py-1 bg-slate-900 border border-slate-700 text-slate-300 rounded">{t}</span>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ENTERPRISE CASE STUDIES -->
    <section id="cases" class="py-20 border-b border-slate-800/80">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-2xl mb-12">
          <div class="font-mono text-xs text-indigo-400">[ ENTREGAS CORPORATIVAS AUDITÁVEIS ]</div>
          <h2 class="mt-2 text-3xl font-extrabold text-slate-50 tracking-tight">
            Arquiteturas Selecionadas de Clientes &amp; Produtos.
          </h2>
          <p class="mt-3 text-slate-400">
            Cases corporativos reais com zero enrolação comercial. Cada métrica é respaldada por código em produção e histórico comprovado.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {projects.map((proj) => (
            <article class={`border border-slate-800 bg-[#0C121E] hover:border-indigo-500/50 transition-all rounded-lg p-6 flex flex-col justify-between ${proj.featured ? 'md:col-span-2 lg:col-span-2 bg-[#0E1526]' : ''}`}>
              <div>
                <div class="flex items-center justify-between font-mono text-[11px] text-slate-400 border-b border-slate-800 pb-3">
                  <span class="text-indigo-400 font-bold">{proj.client}</span>
                  <span>{proj.category}</span>
                </div>

                <h3 class="mt-4 text-xl font-bold text-slate-100 tracking-tight">
                  {proj.title}
                </h3>

                <p class="mt-3 text-sm text-slate-300 leading-relaxed">
                  {proj.description}
                </p>

                <div class="mt-5 grid grid-cols-3 gap-2 py-3 px-3 bg-slate-950/70 border border-slate-800 rounded font-mono text-xs">
                  {proj.metrics.map(m => (
                    <div>
                      <div class="text-[10px] text-slate-500 uppercase">{m.label}</div>
                      <div class="text-slate-200 font-bold mt-0.5">{m.value}</div>
                    </div>
                  ))}
                </div>
              </div>

              <div class="mt-6 pt-4 border-t border-slate-800">
                <div class="flex flex-wrap gap-1.5 mb-4">
                  {proj.tech.map(t => (
                    <span class="font-mono text-[10px] px-2 py-0.5 rounded bg-slate-900 border border-slate-800 text-slate-300">
                      {t}
                    </span>
                  ))}
                </div>

                <div class="flex items-center justify-between text-xs font-mono">
                  <a href={proj.demoUrl} target="_blank" rel="noopener noreferrer" class="text-indigo-400 hover:text-white transition-colors flex items-center gap-1">
                    <span>Inspecionar Sistema</span> &rarr;
                  </a>
                  <a href={proj.githubUrl} target="_blank" rel="noopener noreferrer" class="text-slate-500 hover:text-slate-300 transition-colors">
                    GitHub Spec
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- CORE DISCIPLINES -->
    <section id="disciplines" class="py-20 border-b border-slate-800/80 bg-[#0A0F1A]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-2xl mb-12">
          <div class="font-mono text-xs text-indigo-400">[ MATRIZ DE CAPACIDADES ]</div>
          <h2 class="mt-2 text-3xl font-extrabold text-slate-50 tracking-tight">
            Disciplinas Arquiteturais &amp; Escopo.
          </h2>
        </div>

        <div class="grid md:grid-cols-2 gap-6">
